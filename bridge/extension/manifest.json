{
  "manifest_version": 3,
  "name": "Arena MCP Bridge",
  "version": "2.0.0",
  "description": "Connects the local Arena MCP to this browser: background tabs, tab groups, page actions. Localhost only.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Arena MCP Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "isolate.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cursor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}