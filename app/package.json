{
  "name": "arena-local-bridge",
  "version": "1.1.0",
  "description": "Arena desktop workspace with embedded official website, encrypted bulk mailboxes, model fingerprinting and a local OpenAI-compatible API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gandhara2077/arena-local-bridge.git"
  },
